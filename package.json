{
  "name": "browser-bench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "lint:rust": "node scripts/lint-rust.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "size": "node scripts/check-size.mjs",
    "check": "npm run build && npm run typecheck && npm run lint:rust && npm run test && npm run size",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
